// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  OWNER
  ADMIN
  MEMBER
}

enum DepartmentRole {
  MANAGER
  MEMBER
}

enum StepType {
  START
  APPROVAL
  INPUT
  IF_ELSE
  INTEGRATION_EMAIL
  INTEGRATION_TELEGRAM_SLACK
  WEBHOOK
  END
}

enum SlaAction {
  NONE
  AUTO_APPROVE
  AUTO_REJECT
  ESCALATE
}

enum InstanceStatus {
  DRAFT
  PENDING
  RUNNING
  COMPLETED
  REJECTED
  CANCELLED
}

enum InstanceStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  SKIPPED
}

enum ActionTaken {
  APPROVE
  REJECT
  SUBMIT
  AUTO_SYSTEM
}

enum IntegrationProvider {
  EMAIL
  TELEGRAM
  SLACK
}

enum NotificationType {
  SLA_WARNING
  APPROVAL_REQUEST
  COMMENT
  SYSTEM
}

model User {
  id               String                 @id @default(uuid())
  email            String                 @unique
  password         String
  name             String
  avatarUrl        String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  
  workspacesOwned  Workspace[]            @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  userDepartments  UserDepartment[]
  createdTemplates WorkflowTemplate[]     @relation("TemplateCreator")
  instancesRequested WorkflowInstance[]   @relation("InstanceRequester")
  assignedSteps    WorkflowInstanceStep[] @relation("StepAssignee")
  comments         WorkflowComment[]
  attachments      WorkflowAttachment[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
}

model Workspace {
  id           String                 @id @default(uuid())
  name         String
  slug         String                 @unique
  ownerId      String
  owner        User                   @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  
  members      WorkspaceMember[]
  departments  Department[]
  templates    WorkflowTemplate[]
  integrations WorkspaceIntegration[]
  activityLogs ActivityLog[]
}

model WorkspaceMember {
  id          String     @id @default(uuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        SystemRole @default(MEMBER)
  createdAt   DateTime   @default(now())
  
  @@unique([workspaceId, userId])
}

model Department {
  id          String           @id @default(uuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  code        String
  parentId    String?
  parent      Department?      @relation("SubDepartments", fields: [parentId], references: [id])
  children    Department[]     @relation("SubDepartments")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  userDepartments UserDepartment[]
  instances       WorkflowInstance[]
}

model UserDepartment {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  role         DepartmentRole @default(MEMBER)
  createdAt    DateTime       @default(now())
  
  @@unique([userId, departmentId])
}

model WorkflowTemplate {
  id               String               @id @default(uuid())
  workspaceId      String
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  isPublic         Boolean              @default(false)
  publicSlug       String?              @unique
  publicFormConfig Json?
  createdById      String
  creator          User                 @relation("TemplateCreator", fields: [createdById], references: [id])
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  
  steps            WorkflowStep[]
  transitions      WorkflowTransition[]
  formFields       WorkflowFormField[]
  instances        WorkflowInstance[]
}

model WorkflowStep {
  id          String                 @id @default(uuid())
  templateId  String
  template    WorkflowTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name        String
  type        StepType
  config      Json?
  slaDuration Int?
  slaAction   SlaAction              @default(NONE)
  xPos        Float                  @default(0)
  yPos        Float                  @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  
  transitionsFrom WorkflowTransition[]   @relation("TransitionFrom")
  transitionsTo   WorkflowTransition[]   @relation("TransitionTo")
  instanceSteps   WorkflowInstanceStep[]
  formFields      WorkflowFormField[]
}

model WorkflowTransition {
  id             String           @id @default(uuid())
  templateId     String
  template       WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fromStepId     String
  fromStep       WorkflowStep     @relation("TransitionFrom", fields: [fromStepId], references: [id], onDelete: Cascade)
  toStepId       String
  toStep         WorkflowStep     @relation("TransitionTo", fields: [toStepId], references: [id], onDelete: Cascade)
  conditionRules Json?
  createdAt      DateTime         @default(now())
}

model WorkflowFormField {
  id              String           @id @default(uuid())
  templateId      String
  template        WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stepId          String?
  step            WorkflowStep?    @relation(fields: [stepId], references: [id], onDelete: SetNull)
  name            String
  label           String
  fieldType       String           // e.g. TEXT, NUMBER, DATE, SELECT, FILE
  isRequired      Boolean          @default(false)
  options         Json?
  validationRules Json?
  order           Int              @default(0)
  createdAt       DateTime         @default(now())
}

model WorkflowInstance {
  id             String                 @id @default(uuid())
  templateId     String
  template       WorkflowTemplate       @relation(fields: [templateId], references: [id])
  title          String
  requesterId    String?
  requester      User?                  @relation("InstanceRequester", fields: [requesterId], references: [id])
  requesterEmail String?
  currentStepId  String?
  status         InstanceStatus         @default(PENDING)
  currentData    Json
  branchId       String?
  branch         Department?            @relation(fields: [branchId], references: [id])
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  
  instanceSteps  WorkflowInstanceStep[]
  comments       WorkflowComment[]
  attachments    WorkflowAttachment[]
}

model WorkflowInstanceStep {
  id                String             @id @default(uuid())
  instanceId        String
  instance          WorkflowInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepId            String
  step              WorkflowStep       @relation(fields: [stepId], references: [id])
  status            InstanceStepStatus @default(PENDING)
  assignedToUserId  String?
  assignedToUser    User?              @relation("StepAssignee", fields: [assignedToUserId], references: [id])
  startedAt         DateTime           @default(now())
  dueAt             DateTime?
  completedAt       DateTime?
  actionTaken       ActionTaken?
  comment           String?
  createdAt         DateTime           @default(now())
}

model WorkflowComment {
  id         String           @id @default(uuid())
  instanceId String
  instance   WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime         @default(now())
}

model WorkflowAttachment {
  id           String           @id @default(uuid())
  instanceId   String
  instance     WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepId       String?
  uploadedById String?
  uploadedBy   User?            @relation(fields: [uploadedById], references: [id])
  fileName     String
  fileUrl      String
  fileSize     Int
  createdAt    DateTime         @default(now())
}

model WorkspaceIntegration {
  id          String              @id @default(uuid())
  workspaceId String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider    IntegrationProvider
  credentials Json
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  content     String
  type        NotificationType
  isRead      Boolean          @default(false)
  redirectUrl String?
  createdAt   DateTime         @default(now())
}

model ActivityLog {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  targetType  String
  targetId    String
  details     Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())
}
